{
  "name": "plasma",
  "version": "3.1.3",
  "description": "A quiet place for queries. A modern Electron-based Postgres client.",
  "homepage": "https://plasma.sh",
  "private": true,
  "type": "module",
  "author": "",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "postinstall": "node scripts/postinstall.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:upload": "node scripts/upload-release.mjs",
    "release:verify": "node scripts/upload-release.mjs --verify-only",
    "release:verify:mac": "node scripts/upload-release.mjs --verify-only --mac-only",
    "release:ship": "pnpm run dist:win && pnpm run release:upload",
    "release:mac": "pnpm run dist:mac && node scripts/upload-release.mjs --mac-only",
    "ship:patch": "node scripts/ship.mjs patch",
    "ship:minor": "node scripts/ship.mjs minor",
    "ship:major": "node scripts/ship.mjs major",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ipc": "playwright test -c e2e/playwright.config.ts --project=ipc",
    "e2e:fixtures:up": "docker compose -f e2e/compose.yml up -d --wait",
    "e2e:fixtures:down": "docker compose -f e2e/compose.yml down -v",
    "e2e:local": "bash e2e/scripts/run-local.sh",
    "dist:linux": "electron-vite build && electron-builder --linux --x64",
    "release:linux": "pnpm run dist:linux && node scripts/upload-release.mjs --linux-only",
    "gen:update-key": "node scripts/gen-update-key.mjs"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@duckdb/node-api": "1.5.6-r.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.2.3",
    "electron-updater": "^6.8.9",
    "ioredis": "^5.10.1",
    "mysql2": "^3.24.5",
    "pg": "^8.13.1",
    "pg-cursor": "2.12.2",
    "sql-formatter": "^15.4.10",
    "ssh2": "^1.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "1.49.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/pg-cursor": "2.7.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "electron": "~44.4.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.52.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@biomejs/biome"
    ],
    "ignoredOptionalDependencies": [
      "cpu-features"
    ],
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "linux",
        "win32"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "node-abi@^4": "^4.35.0",
      "js-yaml@^4": "^4.3.2"
    }
  }
}
