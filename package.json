{
  "name": "plasma",
  "version": "0.0.15",
  "description": "A quiet place for queries. A modern Electron-based Postgres client.",
  "private": true,
  "type": "module",
  "author": "",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --x64",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "prepare": "node scripts/build-icons.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:upload": "node scripts/upload-release.mjs",
    "release:ship": "pnpm run dist:win && pnpm run release:upload",
    "ship:patch": "node scripts/ship.mjs patch",
    "ship:minor": "node scripts/ship.mjs minor",
    "ship:major": "node scripts/ship.mjs major",
    "rebuild": "electron-rebuild",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@opensearch-project/opensearch": "^3.6.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "electron-log": "^5.2.3",
    "electron-updater": "^6.8.3",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.52.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.4.10",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^2.5.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron/rebuild": "^3.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@vercel/blob": "^2.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@biomejs/biome",
      "better-sqlite3"
    ],
    "ignoredOptionalDependencies": [
      "cpu-features"
    ]
  }
}
