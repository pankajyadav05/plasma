# pnpm settings for Electron — hoist Electron-related packages so electron-builder / electron-vite can find them
public-hoist-pattern[]=*electron*
public-hoist-pattern[]=*@types*
public-hoist-pattern[]=*vite*
public-hoist-pattern[]=*tailwind*
public-hoist-pattern[]=*postcss*
public-hoist-pattern[]=*autoprefixer*
shamefully-hoist=false
strict-peer-dependencies=false

# pnpm 11 defaults blockExoticSubdeps=true, which breaks installs because
# @electron/rebuild depends on @electron/node-gyp via a git ref. Allow it.
block-exotic-subdeps=false
